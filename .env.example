# Copy this file to .env and fill in your values. .env is git-ignored.
#   cp .env.example .env

# Hugging Face token for pyannote speaker diarization (Read token is enough).
# Get it at https://huggingface.co/settings/tokens and accept the terms on:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local LLM model served by Ollama (optional override).
LLM_MODEL=llama3.1:8b

